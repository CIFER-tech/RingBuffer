<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>CIFER.Tech.RingBuffer</AssemblyName>
    <RootNamespace>CIFER.Tech.Collections</RootNamespace>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <!-- ソースは Unity パッケージの Runtime に 1 つだけ置き、.NET のライブラリとしても同じファイルをビルドする。 -->
  <ItemGroup>
    <Compile Include="..\..\Unity\Runtime\RingBuffer.cs" Link="RingBuffer.cs" />
  </ItemGroup>

</Project>
