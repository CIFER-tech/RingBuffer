<Project Sdk="Microsoft.NET.Sdk">

  <!-- netstandard2.1: 普通の .NET アプリからも、Unity (2021.2+) のパッケージに同梱した DLL からも使える -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>CIFER.tech.RingBuffer</AssemblyName>
    <RootNamespace>CIFER.tech.RingBuffer</RootNamespace>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <Deterministic>true</Deterministic>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>CIFER.tech.RingBuffer</PackageId>
    <Version>4.0.0</Version>
    <Authors>CIFER.tech</Authors>
    <Description>固定サイズのリングバッファ (輪になった待ち行列)。入れる・取り出すで GC が起きず、満杯のときは古い要素を捨てる。スレッドに対して安全。</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/CIFER-tech/RingBuffer</RepositoryUrl>
  </PropertyGroup>

</Project>
